{
  "name": "raphaelcangucu/mautic-multi-mail-bundle",
  "description": "Independent Mautic SMTP/API connections with per-connection fallback and a native mail transport.",
  "type": "mautic-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.2",
    "mautic/core-lib": "^7.2",
    "symfony/mailer": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/amazon-mailer": "^7.4",
    "symfony/resend-mailer": "^7.4",
    "symfony/mailgun-mailer": "^7.4",
    "symfony/sendgrid-mailer": "^7.4",
    "symfony/postmark-mailer": "^7.4",
    "symfony/brevo-mailer": "^7.4",
    "symfony/dependency-injection": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "MauticPlugin\\MauticMultiMailBundle\\": ""
    }
  },
  "extra": {
    "install-directory-name": "MauticMultiMailBundle"
  }
}
